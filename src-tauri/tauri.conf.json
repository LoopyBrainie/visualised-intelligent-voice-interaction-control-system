{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "visualised-intelligent-voice-interaction-control-system",
  "version": "0.1.0",
  "identifier": "loopybrainie.visualised-intelligent-voice-interaction-control-system",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "visualised-intelligent-voice-interaction-control-system",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../python_engine": "python_engine"
    }
  }
}

